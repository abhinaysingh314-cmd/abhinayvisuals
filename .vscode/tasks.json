{
  // Terminal → Run Task… → "Start site"  (or Cmd+Shift+B)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start site",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "serve",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activeBegin": ".",
          "beginsPattern": ".",
          "endsPattern": "running at"
        }
      }
    }
  ]
}
