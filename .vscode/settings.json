{
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true
  },
  "search.exclude": {
    "assets/video": true,
    "media ": true
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },
  "emmet.includeLanguages": {
    "javascript": "html"
  },
  "css.lint.unknownAtRules": "ignore",
  "liveServer.settings.port": 5500,
  "liveServer.settings.ignoreFiles": ["media /**", "scripts/**", "*.md"]
}
